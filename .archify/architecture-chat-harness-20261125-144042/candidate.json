  "cards": [
    {
      "dot": "cyan",
      "title": "One turn (AG-UI over SSE)",
      "items": [
        "Lease _locks/<oid>/<conv> in Blob (60 s, renewed 20 s); 409 if busy",
        "Hydrate /tmp (emptyDir 4Gi) → Pi loop: model ⇄ tools ⇄ MCP",
        "Upload diff, save versioned history, usage row, wipe /tmp",
        "Curator saves memory after the answer; CronJob catches up nightly"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Envoy is the only ingress (tenant sign-in, share links too); it overwrites x-user-oid from the JWT",
        "File tools confined to the turn workspace; bash is emulated (just-bash)",
        "Tokens and memory sealed AES-256-GCM with AAD = oid",
        "llm-gateway injects the OpenRouter key; chat-api never holds it"
      ]
    },
    {
      "dot": "emerald",
      "title": "Network primitives",
      "items": [
        "Egress: AKS LB outbound IP; Blob via Microsoft.Storage service endpoint",
        "Blob firewall: default Deny, shared keys disabled, TLS 1.2",
        "NetworkPolicy: 443 out only to public IPs (RFC1918 excluded); DNS to kube-dns",
        "Host chat.<ip>.sslip.io; route timeout 900 s for long SSE turns"
      ]
    },
    {
      "dot": "amber",
      "title": "Prisma runtime rules",
      "items": [
        "Read-only rootfs, non-root, seccomp RuntimeDefault, /tmp only",
        "No subprocess (guarded in code), no runtime downloads",
        "Scratch/Wolfi images; Trivy blocks HIGH/CRITICAL before GHCR",
        "Only MIT / Apache-2.0 / BSD dependencies"
      ]
    },
    {
      "dot": "violet",
      "title": "Inside chat-api",
      "items": [
        "Tools: files, bash, parse, office/PDF writers, canvas, show_ui, plan",
        "Projects (shared instructions + read-only files) and share links (frozen copies); memory: core, episodic, graph, skills",
        "Connectors: OAuth + PKCE (GitHub, Azure DevOps, Microsoft Graph)",
        "Gate: approvals + loop breaker; cost ledger in BRL"
      ]
    }
  ]
}